  m_Script: {fileID: 11500000, guid: a112afaff4d02404bacc506bac52d751, type: 3}
  m_Name: dlg_7
  m_EditorClassIdentifier: 
  id: dlg_7
  dialogueSlots:
  - visibility: 0
    title: Little Devil
    title_color: {r: 0.93725497, g: 0.1137255, b: 0.1137255, a: 1}
    icon: {fileID: 21300000, guid: dfd6067bb0c7e534398e17aae39af9a1, type: 3}
    string_text: Hello! I'm a little devil!
  - visibility: 1
    title: Blue Angel
    title_color: {r: 0.11372548, g: 0.631741, b: 0.9372549, a: 1}
    icon: {fileID: 21300000, guid: ed6c2fd5d46cdf14f869f5180fd6680e, type: 3}
    string_text: Hi! How dare you come to our heaven?
  - visibility: 0
    title: Little Devil
    title_color: {r: 0.93725497, g: 0.1137255, b: 0.1137255, a: 1}
    icon: {fileID: 21300000, guid: dfd6067bb0c7e534398e17aae39af9a1, type: 3}
    string_text: Because I'm a true evil.
  - visibility: 1
    title: Blue Angel
    title_color: {r: 0.11372548, g: 0.631741, b: 0.9372549, a: 1}
    icon: {fileID: 21300000, guid: ed6c2fd5d46cdf14f869f5180fd6680e, type: 3}
    string_text: Okay. I'm understand. You are just a spoiled little boy.
  - visibility: 0
    title: Little Devil
    title_color: {r: 0.93725497, g: 0.1137255, b: 0.1137255, a: 1}
    icon: {fileID: 21300000, guid: dfd6067bb0c7e534398e17aae39af9a1, type: 3}
    string_text: I'll burn you all!
  - visibility: 0
    title: Little Devil
    title_color: {r: 0.93725497, g: 0.1137255, b: 0.1137255, a: 1}
    icon: {fileID: 21300000, guid: dfd6067bb0c7e534398e17aae39af9a1, type: 3}
    string_text: AAAAA!!!
  - visibility: 2
    title: Little Devil
    title_color: {r: 0.93725497, g: 0.1137255, b: 0.1137255, a: 1}
    icon: {fileID: 21300000, guid: dfd6067bb0c7e534398e17aae39af9a1, type: 3}
    string_text: '[The little devil had always a lack of patience]'
